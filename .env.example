# Docker Compose. Скопируйте в .env и замените оба значения перед запуском.
SA_PASSWORD=replace-with-a-strong-sql-server-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

DB_NAME=local_project_db
BACKEND_PORT=8080
FRONTEND_PORT=5173
APP_ENV=development

# Используются только явной командой `make bootstrap-user`.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
BOOTSTRAP_ROLE=admin
