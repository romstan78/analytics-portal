# Docker Compose. Скопируйте в .env и замените оба значения перед запуском.
SA_PASSWORD=replace-with-a-strong-sql-server-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

DB_NAME=local_project_db
BACKEND_PORT=8080
FRONTEND_PORT=5173
APP_ENV=development

# Изолированный демонстрационный контур (docker-compose.demo.yml).
DEMO_DB_NAME=local_project_demo_db
DEMO_MSSQL_PORT=1434
DEMO_BACKEND_PORT=8081
DEMO_FRONTEND_PORT=5174
# Отдельная случайная строка предпочтительнее; если не задана, загрузчик
# использует JWT_SECRET и всё равно не сохраняет исходные соответствия.
DEMO_MAPPING_SALT=replace-with-a-random-demo-mapping-salt

# Используются только явной командой `make bootstrap-user`.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
BOOTSTRAP_ROLE=admin

# Используются только явной командой `make demo-bootstrap-user`.
DEMO_BOOTSTRAP_USERNAME=demo_admin
DEMO_BOOTSTRAP_PASSWORD=replace-with-a-unique-demo-password-at-least-12-characters
DEMO_BOOTSTRAP_ROLE=admin
