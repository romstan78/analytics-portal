DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=your_password_here
DB_NAME=local_project_db
DB_PORT=1433
DB_AUTO_CREATE=true
DB_STARTUP_TIMEOUT_SECONDS=90
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
PORT=8080
# Сгенерируйте уникальный секрет длиной не менее 32 символов. Не коммитьте реальное значение.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Только для явного запуска `go run ./cmd/bootstrap_user`.
# Команда никогда не перезаписывает существующего пользователя.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
BOOTSTRAP_ROLE=admin
