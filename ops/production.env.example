# Скопируйте в защищённое хранилище окружения; этот файл не содержит секретов.
APP_ENV=production
DB_NAME=analytics_portal
DB_AUTO_CREATE=false
MSSQL_PID=Standard

# Шифрование соединения с SQL Server: true или strict.
DB_ENCRYPT=true
# Обязательно задать явно. false — сертификат SQL Server проверяется по
# доверенным корням (нужен сертификат от вашего CA). true — осознанное
# доверие самоподписанному сертификату SQL Server во внутренней сети.
DB_TRUST_SERVER_CERT=false

# Публичные HTTPS-адреса без завершающего слеша.
CORS_ORIGINS=https://portal.example.com
PUBLIC_API_BASE=https://api.portal.example.com
# Точные IP/CIDR вашего ingress или reverse proxy, через запятую.
TRUSTED_PROXIES=10.0.0.10

# Секретные значения задаются через окружение/secret manager и не коммитятся.
SA_PASSWORD=replace-in-secret-manager
JWT_SECRET=replace-in-secret-manager-at-least-32-characters
